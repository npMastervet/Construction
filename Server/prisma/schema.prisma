generator client {
  provider = "prisma-client-js"
}

// Prisma 7: ไม่ใส่ `url` ใน schema นี้ — ค่าเชื่อมต่ออยู่ที่ prisma.config.ts → datasource.url (env DATABASE_URL)
// ถ้าใส่ url ใน schema จะ error P1012 ตอน prisma validate
datasource db {
  provider = "mysql"
}

// ============================================================================
// Workspace Starter — schema ตั้งต้น มีเฉพาะสิ่งที่ระบบ login ต้องใช้
//
// เพิ่มโมดูลใหม่: เพิ่ม model ของโมดูลต่อท้ายไฟล์นี้ แล้วเพิ่ม back-relation
// ที่ model User โดยตั้งชื่อ relation ให้ขึ้นต้นด้วยชื่อโมดูล เพื่อให้ถอดออกทีหลังได้ง่าย
// ============================================================================

enum AuthProvider {
  GOOGLE
  LOCAL
  BOTH
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

/// ลำดับสิทธิ์: USER < HR < ADMIN < SUPERADMIN — บังคับใช้ที่ middleware/roleMiddleware.js
enum UserRole {
  USER
  HR
  ADMIN
  SUPERADMIN
}

/// บริษัทในเครือ — ค่าเหล่านี้เป็นตัวอย่าง ให้แก้ตามองค์กรที่นำ starter ไปใช้
enum UserCompany {
  MasterVet
  Zettapharma
}

enum LoginAttemptStatus {
  SUCCESS
  FAILURE
}

model User {
  id          String  @id @default(cuid())
  email       String  @unique
  displayName String?
  nickName    String?
  position    String?
  telephone   String?
  avatarUrl   String?

  authProvider AuthProvider @default(GOOGLE)
  /// ใน MySQL หลายแถวที่ googleId = NULL ไม่ชน unique — เหมาะกับบัญชี local-only
  googleId     String?      @unique
  googleName   String?
  /// ต้องมีค่าเมื่อ authProvider = LOCAL หรือ BOTH
  passwordHash String?

  role        UserRole    @default(USER)
  company     UserCompany @default(Zettapharma)
  status      UserStatus  @default(ACTIVE)
  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]
  loginAttempts LoginAttempt[]
  memberships   OrganizationMember[]
  auditEvents   AuditLog[]

  @@map("user")
}

enum OrganizationRole {
  OWNER
  ACCOUNTANT
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum ProjectRole {
  MANAGER
  RECORDER
  VIEWER
}

enum ProjectStatus {
  DRAFT
  QUOTATION
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SupplierStatus {
  ACTIVE
  ARCHIVED
}

model Organization {
  id             String               @id @default(cuid())
  code           String               @unique @db.VarChar(40)
  name           String               @db.VarChar(200)
  status         MembershipStatus     @default(ACTIVE)
  currency       String               @default("THB") @db.VarChar(3)
  timezone       String               @default("Asia/Bangkok") @db.VarChar(50)
  defaultVatRate Decimal              @default(0) @db.Decimal(7, 6)
  version        Int                  @default(1)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  members        OrganizationMember[]
  projects       Project[]
  suppliers      Supplier[]
  audits         AuditLog[]

  @@map("organization")
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  version        Int              @default(1)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  projects       ProjectMember[]

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@map("organization_member")
}

model Project {
  id              String          @id @default(cuid())
  organizationId  String
  code            String          @db.VarChar(40)
  name            String          @db.VarChar(200)
  clientName      String          @db.VarChar(200)
  clientContact   String?         @db.VarChar(500)
  location        String?         @db.VarChar(1000)
  startDate       DateTime?       @db.Date
  endDate         DateTime?       @db.Date
  status          ProjectStatus   @default(DRAFT)
  contractNet     Decimal?        @db.Decimal(18, 2)
  contractVatRate Decimal?        @db.Decimal(7, 6)
  contractVat     Decimal?        @db.Decimal(18, 2)
  contractGross   Decimal?        @db.Decimal(18, 2)
  createdByUserId String
  version         Int             @default(1)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  members         ProjectMember[]
  audits          AuditLog[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId, status, updatedAt])
  @@map("project")
}

model ProjectMember {
  id                   String             @id @default(cuid())
  organizationId       String
  projectId            String
  organizationMemberId String
  role                 ProjectRole
  canReadCosts         Boolean            @default(false)
  status               MembershipStatus   @default(ACTIVE)
  version              Int                @default(1)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  project              Project            @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict)
  member               OrganizationMember @relation(fields: [organizationId, organizationMemberId], references: [organizationId, id], onDelete: Restrict)

  @@unique([projectId, organizationMemberId])
  @@index([organizationId, organizationMemberId, status])
  @@map("project_member")
}

model Supplier {
  id              String         @id @default(cuid())
  organizationId  String
  name            String         @db.VarChar(200)
  taxId           String?        @db.VarChar(13)
  contactName     String?        @db.VarChar(200)
  telephone       String?        @db.VarChar(50)
  email           String?        @db.VarChar(254)
  address         String?        @db.VarChar(2000)
  status          SupplierStatus @default(ACTIVE)
  createdByUserId String
  version         Int            @default(1)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, status, name])
  @@map("supplier")
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String?
  actorUserId    String
  action         String       @db.VarChar(80)
  entityType     String       @db.VarChar(40)
  entityId       String
  changes        Json
  occurredAt     DateTime     @default(now())
  requestId      String       @db.VarChar(80)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project        Project?     @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict)
  actor          User         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, occurredAt])
  @@index([organizationId, projectId, occurredAt])
  @@map("audit_log")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique @db.VarChar(64)
  userId    String
  expiresAt DateTime
  /// เซ็ตค่าเมื่อถูก rotate หรือ logout — token ที่ revoke แล้วใช้ต่อไม่ได้
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_token")
}

/// บันทึกความพยายาม login ทุกครั้ง (สำเร็จและล้มเหลว) — เขียนโดย loginAttemptService
model LoginAttempt {
  id            String             @id @default(cuid())
  email         String?
  status        LoginAttemptStatus
  failureReason String?            @db.VarChar(500)
  ipAddress     String?            @db.VarChar(64)
  userId        String?
  user          User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime           @default(now())

  @@index([email])
  @@index([userId])
  @@index([createdAt])
  @@map("login_attempt")
}
