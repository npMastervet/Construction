# Construction API — copy via npm run setup, then configure locally.
NODE_ENV=development
PORT=5001
# Set actual dedicated database credentials. This example does not create a DB.
DATABASE_URL="mysql://construction:replace_this_password@localhost:3306/construction"
# setup generates a random local secret; never commit it.
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback
BASE_URL=http://localhost:5001
FRONTEND_SUCCESS_URL=http://localhost:5174
FRONTEND_LOGIN_URL=http://localhost:5174/login
ALLOWED_ORIGINS=http://localhost:5174
# 0 for direct access. Set exact trusted proxy hop count in deployment.
TRUST_PROXY_HOPS=0
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
RATE_LIMIT_AUTH_MAX=20
