generator client {
  provider = "prisma-client-js"
}

// Prisma 7: ไม่ใส่ `url` ใน schema นี้ — ค่าเชื่อมต่ออยู่ที่ prisma.config.ts → datasource.url (env DATABASE_URL)
// ถ้าใส่ url ใน schema จะ error P1012 ตอน prisma validate
datasource db {
  provider = "mysql"
}

// ============================================================================
// Workspace Starter — schema ตั้งต้น มีเฉพาะสิ่งที่ระบบ login ต้องใช้
//
// เพิ่มโมดูลใหม่: เพิ่ม model ของโมดูลต่อท้ายไฟล์นี้ แล้วเพิ่ม back-relation
// ที่ model User โดยตั้งชื่อ relation ให้ขึ้นต้นด้วยชื่อโมดูล เพื่อให้ถอดออกทีหลังได้ง่าย
// ============================================================================

enum AuthProvider {
  GOOGLE
  LOCAL
  BOTH
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

/// ลำดับสิทธิ์: USER < HR < ADMIN < SUPERADMIN — บังคับใช้ที่ middleware/roleMiddleware.js
enum UserRole {
  USER
  HR
  ADMIN
  SUPERADMIN
}

/// บริษัทในเครือ — ค่าเหล่านี้เป็นตัวอย่าง ให้แก้ตามองค์กรที่นำ starter ไปใช้
enum UserCompany {
  MasterVet
  Zettapharma
}

enum LoginAttemptStatus {
  SUCCESS
  FAILURE
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  displayName String?
  nickName    String?
  position    String?
  telephone   String?
  avatarUrl   String?

  authProvider AuthProvider @default(GOOGLE)
  /// ใน MySQL หลายแถวที่ googleId = NULL ไม่ชน unique — เหมาะกับบัญชี local-only
  googleId     String?      @unique
  googleName   String?
  /// ต้องมีค่าเมื่อ authProvider = LOCAL หรือ BOTH
  passwordHash String?

  role        UserRole    @default(USER)
  company     UserCompany @default(Zettapharma)
  status      UserStatus  @default(ACTIVE)
  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]
  loginAttempts LoginAttempt[]

  @@map("user")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique @db.VarChar(64)
  userId    String
  expiresAt DateTime
  /// เซ็ตค่าเมื่อถูก rotate หรือ logout — token ที่ revoke แล้วใช้ต่อไม่ได้
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_token")
}

/// บันทึกความพยายาม login ทุกครั้ง (สำเร็จและล้มเหลว) — เขียนโดย loginAttemptService
model LoginAttempt {
  id            String             @id @default(cuid())
  email         String?
  status        LoginAttemptStatus
  failureReason String?            @db.VarChar(500)
  ipAddress     String?            @db.VarChar(64)
  userId        String?
  user          User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime           @default(now())

  @@index([email])
  @@index([userId])
  @@index([createdAt])
  @@map("login_attempt")
}
